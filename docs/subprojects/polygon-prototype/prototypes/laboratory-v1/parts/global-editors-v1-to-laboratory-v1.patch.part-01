+<!-- POLYGON_LAB_V3: map-first experimental parameter laboratory UX prototype; metrics-style parameter constructor -->
+<style id="polygonLabV2Styles">
+.lab-v2-shell{height:100%;min-height:0;display:flex;flex-direction:column;background:rgba(250,249,244,.72)}
+.lab-v2-top{flex:0 0 auto;padding:8px;border-bottom:1px solid var(--line);background:#ecebe3}.lab-v2-topline{display:flex;align-items:center;gap:6px}.lab-v2-topline .action-button{flex:1;min-height:30px}.lab-v2-demo{padding:4px 6px;border:1px solid #c7c19f;border-radius:3px;background:#f8f3d8;color:#706530;font-size:7px;font-weight:900;letter-spacing:.06em}
+.lab-v2-subtabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-top:7px}.lab-v2-subtabs button{height:29px;border:1px solid var(--line);border-radius:4px;background:#fff;font-size:8px;font-weight:900;text-transform:uppercase}.lab-v2-subtabs button.is-active{background:var(--top);border-color:var(--top);color:#fff}
+.lab-v2-toolbar{display:flex;align-items:center;gap:4px;margin-top:7px}.lab-v2-tool{height:29px;min-width:30px;display:inline-flex;align-items:center;justify-content:center;gap:5px;padding:0 7px;border:1px solid var(--line-strong);border-radius:4px;background:#fff;font-size:8px;font-weight:850;white-space:nowrap}.lab-v2-tool:hover{background:#eeece1}.lab-v2-tool.is-active{background:var(--accent-soft);border-color:#9d8832;color:#393214}.lab-v2-tool:disabled{opacity:.42;cursor:default}.lab-v2-tool b{font-size:12px}.lab-v2-toolbar-spacer{flex:1}
+.lab-v2-status{min-height:26px;display:flex;align-items:center;gap:6px;margin-top:6px;padding:4px 6px;border:1px solid var(--line);border-radius:4px;background:#f7f6ef;color:#676b61;font-size:8px}.lab-v2-status strong{color:#343830}.lab-v2-status .spacer{flex:1}.lab-v2-status button{border:0;background:transparent;color:#725f22;font-size:8px;font-weight:900}
+.lab-v2-list{min-height:0;flex:1;overflow:auto;padding:7px}.lab-v2-change-row,.lab-v2-area-row{width:100%;display:grid;align-items:center;gap:7px;margin-bottom:5px;padding:7px;border:1px solid var(--line);border-radius:5px;background:#fff;text-align:left}.lab-v2-change-row{grid-template-columns:14px minmax(0,1fr) auto 24px}.lab-v2-area-row{grid-template-columns:23px minmax(0,1fr) 24px}.lab-v2-change-row:hover,.lab-v2-area-row:hover{border-color:#85897d}.lab-v2-change-row.is-active,.lab-v2-area-row.is-active{border-color:#9d8832;box-shadow:inset 3px 0 0 var(--accent)}.lab-v2-change-row.is-disabled{opacity:.55}.lab-v2-dot{width:9px;height:9px;border-radius:50%;background:#68705f;box-shadow:0 0 0 2px #e8e9e2}.lab-v2-change-row.is-disabled .lab-v2-dot{background:#aaa}.lab-v2-row-copy{min-width:0}.lab-v2-row-title{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;font-weight:900}.lab-v2-row-meta{display:block;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted);font-size:8px}.lab-v2-row-value{display:flex;align-items:center;gap:4px;white-space:nowrap;font:800 8px var(--mono)}.lab-v2-row-value i{color:#999;font-style:normal}.lab-v2-kebab{width:24px;height:24px;border:0;border-radius:4px;background:transparent;font-weight:900}.lab-v2-kebab:hover{background:#eceae0}.lab-v2-area-icon{width:22px;height:22px;display:grid;place-items:center;border:1px solid #8b7b3c;border-radius:4px;background:#f6efc7;color:#5e521f;font-size:11px}
+.lab-v2-empty{padding:35px 20px;text-align:center;color:var(--muted);font-size:9px;line-height:1.5}.lab-v2-empty strong{display:block;margin-bottom:4px;color:#4d5148;font-size:11px}
+.lab-v2-detail{min-height:0;flex:1;overflow:auto;padding:8px}.lab-v2-back{display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;border:0;background:transparent;color:#5c6257;padding:0;font-size:8px;font-weight:900}.lab-v2-detail-card{border:1px solid var(--line);border-radius:6px;background:#fff;overflow:hidden}.lab-v2-detail-head{padding:10px;border-bottom:1px solid var(--line);background:#f0efe8}.lab-v2-detail-kicker{color:var(--muted);font-size:7px;font-weight:900;text-transform:uppercase;letter-spacing:.07em}.lab-v2-detail-title{margin-top:2px;font-size:13px;font-weight:900}.lab-v2-detail-value{margin-top:8px;display:flex;align-items:baseline;gap:8px;font:900 17px var(--mono)}.lab-v2-detail-value span{color:#8b8e84;font-size:11px}.lab-v2-detail-section{padding:9px 10px;border-top:1px solid var(--line)}.lab-v2-detail-section:first-child{border-top:0}.lab-v2-detail-section h4{margin:0 0 6px;color:#555a50;font-size:7px;letter-spacing:.08em;text-transform:uppercase}.lab-v2-detail-main{font-size:9px;font-weight:850}.lab-v2-detail-sub{margin-top:3px;color:var(--muted);font-size:8px;line-height:1.4}.lab-v2-chip-list{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}.lab-v2-chip{padding:3px 5px;border:1px solid var(--line);border-radius:10px;background:#f4f3ec;font-size:7px;font-weight:800}.lab-v2-detail-actions{display:grid;gap:5px;margin-top:8px}.lab-v2-detail-actions .action-button,.lab-v2-detail-actions .ghost-button,.lab-v2-detail-actions .danger-button{width:100%}
+.lab-v2-builder-overlay{position:fixed;inset:0;z-index:240;display:none;align-items:center;justify-content:center;padding:24px;background:rgba(17,21,13,.54);backdrop-filter:blur(4px)}.lab-v2-builder-overlay.is-open{display:flex}.lab-v2-builder{width:min(1120px,95vw);height:min(760px,90vh);display:flex;flex-direction:column;overflow:hidden;border:1px solid rgba(255,255,255,.3);border-radius:8px;background:var(--panel-solid);box-shadow:0 28px 90px rgba(9,12,7,.38)}
+.lab-v2-builder-head{min-height:58px;display:flex;align-items:center;gap:12px;padding:11px 14px 11px 18px;border-bottom:1px solid var(--line);background:#ecebe3}.lab-v2-builder-head-copy{min-width:0;flex:1}.lab-v2-builder-kicker{color:var(--muted);font-size:8px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.lab-v2-builder-title{margin-top:2px;font-size:17px;font-weight:900}.lab-v2-builder-close{width:34px;height:34px;border:1px solid var(--line);border-radius:4px;background:#fff;font-size:18px}
+.lab-v2-builder-layout{min-height:0;flex:1;display:grid;grid-template-columns:180px minmax(0,1fr)}.lab-v2-builder-nav{padding:10px;border-right:1px solid var(--line);background:#ebeae2}.lab-v2-builder-nav button{width:100%;min-height:40px;display:grid;grid-template-columns:22px minmax(0,1fr);align-items:center;gap:7px;margin-bottom:5px;padding:7px 9px;border:0;border-radius:4px;background:transparent;text-align:left;font-size:9px;font-weight:900}.lab-v2-builder-nav button span:first-child{width:20px;height:20px;display:grid;place-items:center;border:1px solid #b9bbb1;border-radius:50%;background:#fff;font-size:8px}.lab-v2-builder-nav button.is-active{background:var(--top);color:#fff}.lab-v2-builder-nav button.is-active span:first-child{border-color:#fff;background:#fff;color:var(--top)}.lab-v2-builder-nav button.is-done span:first-child{background:#e5efd9;border-color:#728a5e;color:#466035}
+.lab-v2-builder-main{min-width:0;overflow:auto;padding:14px}.lab-v2-builder-footer{min-height:58px;display:flex;align-items:center;gap:8px;padding:9px 14px;border-top:1px solid var(--line);background:#ecebe3}.lab-v2-builder-footer .spacer{flex:1}
+.lab-v2-builder-section-head{margin-bottom:11px}.lab-v2-builder-section-head h3{margin:0;font-size:15px}.lab-v2-builder-section-head p{margin:4px 0 0;color:var(--muted);font-size:8px;line-height:1.45}.lab-v2-search{width:100%;height:36px;border:1px solid var(--line-strong);border-radius:5px;background:#fff;padding:6px 10px;font-size:11px}.lab-v2-param-layout{display:grid;grid-template-columns:180px minmax(0,1fr);gap:10px;margin-top:10px;min-height:430px}.lab-v2-param-cats{display:grid;align-content:start;gap:4px}.lab-v2-param-cats button{min-height:32px;padding:6px 8px;border:1px solid transparent;borde