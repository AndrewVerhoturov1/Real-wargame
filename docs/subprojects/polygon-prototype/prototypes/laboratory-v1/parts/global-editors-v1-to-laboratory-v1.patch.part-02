r-radius:4px;background:#efeee7;text-align:left;font-size:8px;font-weight:900}.lab-v2-param-cats button.is-active{border-color:#9d8832;background:var(--accent-soft);color:#403716}.lab-v2-param-results{min-height:0;max-height:500px;overflow:auto;border:1px solid var(--line);border-radius:5px;background:#fff}.lab-v2-param-result{width:100%;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;padding:9px 10px;border:0;border-bottom:1px solid var(--line);background:#fff;text-align:left}.lab-v2-param-result:last-child{border-bottom:0}.lab-v2-param-result:hover,.lab-v2-param-result.is-selected{background:#f4f0da}.lab-v2-param-result b{display:block;font-size:9px}.lab-v2-param-result small{display:block;margin-top:2px;color:var(--muted);font:7px var(--mono)}.lab-v2-param-result em{align-self:center;color:#777b70;font-size:7px;font-style:normal}.lab-v2-param-selected{margin-top:10px;padding:9px;border:1px solid #b9ae72;border-radius:5px;background:#fff9dc}.lab-v2-param-selected strong{font-size:10px}.lab-v2-param-selected small{display:block;margin-top:3px;color:#6e694f;font:7px var(--mono)}
+.lab-v2-target-types{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.lab-v2-target-type{min-height:58px;padding:8px;border:1px solid var(--line);border-radius:5px;background:#fff;text-align:left}.lab-v2-target-type.is-active{border-color:#9d8832;background:#fff8d7;box-shadow:inset 0 0 0 1px rgba(157,136,50,.14)}.lab-v2-target-type strong{display:block;font-size:9px}.lab-v2-target-type span{display:block;margin-top:3px;color:var(--muted);font-size:7px}.lab-v2-target-panel{margin-top:10px;padding:10px;border:1px solid var(--line);border-radius:5px;background:#fff}.lab-v2-target-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.lab-v2-unit-picks{display:flex;flex-wrap:wrap;gap:4px;margin-top:7px}.lab-v2-unit-pick{padding:4px 6px;border:1px solid var(--line);border-radius:12px;background:#f1f0e8;font-size:7px;font-weight:850}.lab-v2-field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.lab-v2-field{display:grid;gap:4px}.lab-v2-field.wide{grid-column:1/-1}.lab-v2-field label{color:#5f625a;font-size:7px;font-weight:850}.lab-v2-field input,.lab-v2-field select,.lab-v2-field textarea{width:100%;min-width:0;border:1px solid var(--line-strong);border-radius:4px;background:#fff;padding:6px 7px;font-size:9px}.lab-v2-field input,.lab-v2-field select{height:31px}.lab-v2-field textarea{min-height:86px;resize:vertical}
+.lab-v2-value-card{padding:14px;border:1px solid var(--line);border-radius:6px;background:#fff}.lab-v2-value-source{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;padding-bottom:11px;border-bottom:1px solid var(--line)}.lab-v2-value-source span{color:var(--muted);font-size:8px}.lab-v2-value-source strong{font:900 12px var(--mono)}.lab-v2-range-row{display:grid;grid-template-columns:48px minmax(0,1fr) 48px;align-items:center;gap:9px;margin-top:18px}.lab-v2-range-row>span{color:#6d7068;font:8px var(--mono)}.lab-v2-range-row>span:last-child{text-align:right}.lab-v2-range-row input[type=range]{width:100%;accent-color:var(--top)}.lab-v2-number-row{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:12px}.lab-v2-number-row input{width:120px;height:36px;border:1px solid var(--line-strong);border-radius:5px;background:#fff;padding:5px 8px;text-align:right;font:900 13px var(--mono)}.lab-v2-number-row span{font-size:9px;font-weight:800}.lab-v2-delta{margin-top:11px;