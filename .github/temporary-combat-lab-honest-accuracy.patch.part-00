diff --git a/src/combat-lab/combat-lab.css b/src/combat-lab/combat-lab.css
index 0f9d1f0b..9e29df58 100644
--- a/src/combat-lab/combat-lab.css
+++ b/src/combat-lab/combat-lab.css
@@ -302,3 +302,57 @@ body.app-shell-mode-combat-lab.combat-lab-dock-collapsed .map-scale-fixed-label
   body.combat-lab-dock-collapsed #combat-lab-extension-root { right: auto; width: var(--combat-lab-dock-collapsed-width); }
   .combat-lab-scenario-row { grid-template-columns: 1fr 96px; }
 }
+
+.combat-lab-accuracy-controls > .combat-lab-field {
+  margin: 0 8px 8px;
+}
+
+.combat-lab-slider {
+  min-width: 0;
+  display: grid;
+  grid-template-columns: minmax(110px, 1fr) 72px minmax(58px, auto);
+  gap: 6px;
+  align-items: center;
+}
+
+#combat-lab-extension-root .combat-lab-slider input[type='range'] {
+  min-height: 24px;
+  padding: 0;
+  accent-color: #d5c16f;
+}
+
+#combat-lab-extension-root .combat-lab-slider input[type='number'] {
+  min-height: 28px;
+  padding: 4px 5px;
+  text-align: right;
+}
+
+.combat-lab-slider-output {
+  min-width: 0;
+  color: #e7db9c;
+  font: 10px/1.2 ui-monospace, SFMono-Regular, Consolas, monospace;
+  text-align: right;
+  white-space: nowrap;
+}
+
+.combat-lab-accuracy-telemetry {
+  margin: 0 8px 8px;
+  padding: 8px;
+  overflow-wrap: anywhere;
+  border: 1px solid #2f382f;
+  border-radius: 6px;
+  color: #cbd2c8;
+  background: #0d120e;
+  font: 9px/1.45 ui-monospace, SFMono-Regular, Consolas, monospace;
+  white-space: pre-wrap;
+}
+
+#combat-lab-extension-root button.force {
+  border-color: #b98763;
+  background: #33251d;
+}
+
+#combat-lab-extension-root button.force:hover:not(:disabled) {
+  border-color: #e0ad83;
+  background: #4a3022;
+}
