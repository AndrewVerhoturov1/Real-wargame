 }
+function sliderControl(min: number, max: number, step: number, initialValue: number): CombatLabSliderControlV1 {
+  const root = node('div', 'combat-lab-slider');
+  const range = document.createElement('input');
+  range.type = 'range';
+  range.min = String(min);
+  range.max = String(max);
+  range.step = String(step);
+  const number = numberInput(min, max, step);
+  const output = node('output', 'combat-lab-slider-output');
+  const decimals = decimalPlaces(step);
+  const write = (value: number): void => {
+    const normalized = clamp(value, min, max);
+    const text = normalized.toFixed(decimals);
+    range.value = text;
+    number.value = text;
+  };
+  range.addEventListener('input', () => { number.value = range.value; });
+  number.addEventListener('input', () => {
+    const value = Number(number.value);
+    if (Number.isFinite(value)) range.value = String(clamp(value, min, max));
+  });
+  number.addEventListener('change', () => write(Number(number.value)));
+  write(initialValue);
+  root.append(range, number, output);
+  return {
+    root,
+    range,
+    number,
+    output,
+    getValue: () => clamp(finite(number.value), min, max),
+    setValue: write,
+    setOutput: (text: string) => { output.textContent = text; },
+  };
+}
+
 function node<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
   const result = document.createElement(tag);
   result.className = className;
@@ -611,6 +782,41 @@ function orderedList(items: readonly string[]): HTMLOListElement {
   for (const item of items) list.append(node('li', '', item));
   return list;
 }
+function bestContact(
+  shooter: UnitModel,
+  targetUnitId: string,
+): UnitModel['perceptionKnowledge']['contacts'][number] | null {
+  return [...shooter.perceptionKnowledge.contacts]
+    .filter((contact) => contact.sourceUnitId === targetUnitId)
+    .sort((left, right) => (
+      Number(right.visibleNow) - Number(left.visibleNow)
+      || Number(right.observedNow) - Number(left.observedNow)
+      || right.confidence - left.confidence
+      || right.lastUpdatedSeconds - left.lastUpdatedSeconds
+      || left.id.localeCompare(right.id)
+    ))[0] ?? null;
+}
+function proficiencyFromPercent(value: number): WeaponProficiency {
+  if (value < 34) return 'untrained';
+  if (value < 67) return 'trained';
+  return 'specialist';
+}
+function proficiencyPercent(value: WeaponProficiency): number {
+  return value === 'untrained' ? 0 : value === 'specialist' ? 100 : 50;
+}
+function proficiencyLabel(value: WeaponProficiency): string {
+  return value === 'untrained' ? 'Не обучен' : value === 'specialist' ? 'Специалист' : 'Обучен';
+}
+function decimalPlaces(value: number): number {
+  const text = String(value);
+  const separator = text.indexOf('.');
+  return separator < 0 ? 0 : text.length - separator - 1;
+}
+function clamp01(value: number): number { return clamp(value, 0, 1); }
+function clamp(value: number, minimum: number, maximum: number): number {
+  return Math.max(minimum, Math.min(maximum, Number.isFinite(value) ? value : minimum));
+}
+
 function finite(value: string): number {
   const parsed = Number(value);
   return Number.isFinite(parsed) ? parsed : 0;
